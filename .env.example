# Piggycat — server-side environment variables (Netlify Functions only)
# Copy these NAMES into Netlify: Site settings → Environment variables.
# For local testing with `netlify dev`, copy this file to `.env` and fill in.
# NEVER commit a filled-in .env, and NEVER put the service role key in
# config.js or any other frontend file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
